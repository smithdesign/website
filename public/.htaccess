# tobbysmith.com — static site (Astro)
#
# Goal: block AI crawlers, scrapers and agentic browsers while leaving
# conventional search engines free to index the site.
#
# ALLOWED (deliberately absent from the block list below):
#   Googlebot, Googlebot-Image/-Video/-News, Google-InspectionTool,
#   bingbot, Slurp (Yahoo), DuckDuckBot, Applebot (Siri/Spotlight),
#   YandexBot, Baiduspider, PetalBot (Huawei search),
#   facebookexternalhit + Twitterbot + LinkedInBot (link-preview cards),
#   uptime monitors and SEO tools you run yourself (e.g. plain SemrushBot).
#
# This is a denylist of named agents: anything not listed gets through. That
# means zero SEO risk, but a newly launched or renamed scraper will pass until
# its token is added. Refresh from https://github.com/ai-robots-txt/ai.robots.txt

# ----------------------------------------------------------------------
# Block AI / scraper user agents
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On

# OpenAI
RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT|OAI-SearchBot|OpenAI|Operator) [NC,OR]
# Anthropic
RewriteCond %{HTTP_USER_AGENT} (ClaudeBot|Claude-Web|Claude-User|Claude-SearchBot|Claude-Code|anthropic-ai) [NC,OR]
# Google AI surfaces (NOT Googlebot — search indexing stays allowed)
RewriteCond %{HTTP_USER_AGENT} (Google-Extended|GoogleOther|CloudVertexBot|NotebookLM|Google-Gemini|Gemini-Deep-Research|GoogleAgent|Google-Agent|Google-Firebase) [NC,OR]
# Meta (facebookexternalhit intentionally allowed for share previews)
RewriteCond %{HTTP_USER_AGENT} (meta-externalagent|meta-externalfetcher|meta-webindexer|FacebookBot) [NC,OR]
# Apple AI training (plain Applebot stays allowed for Siri/Spotlight)
RewriteCond %{HTTP_USER_AGENT} (Applebot-Extended) [NC,OR]
# Amazon
RewriteCond %{HTTP_USER_AGENT} (Amazonbot|amazon-kendra|amazon-QBusiness|AmazonBuyForMe|Amzn-SearchBot|Amzn-User|bedrockbot|NovaAct) [NC,OR]
# ByteDance / TikTok
RewriteCond %{HTTP_USER_AGENT} (Bytespider|TikTokSpider) [NC,OR]
# Common Crawl / bulk dataset builders
RewriteCond %{HTTP_USER_AGENT} (CCBot|img2dataset|LAIONDownloader|laion|Timpibot|Ai2Bot|AI2Bot|Dolma) [NC,OR]
# Perplexity, Cohere, Mistral, You, Phind and similar answer engines
RewriteCond %{HTTP_USER_AGENT} (PerplexityBot|Perplexity-User|cohere-ai|cohere-training-data-crawler|MistralAI|YouBot|PhindBot|Andibot|LinerBot|ExaBot|TavilyBot|kagi-fetcher|DuckAssistBot|LinkupBot|iAskBot|iaskspider) [NC,OR]
# Chinese AI platforms
RewriteCond %{HTTP_USER_AGENT} "(DeepSeekBot|ChatGLM-Spider|PanguBot|TongyiBot|YiyanBot|Kimi-User|Kangaroo Bot|ICC-Crawler|SBIntuitionsBot)" [NC,OR]
# Yandex AI (plain YandexBot search stays allowed)
RewriteCond %{HTTP_USER_AGENT} (YandexAdditional) [NC,OR]
# Coding agents / headless browsing frameworks
RewriteCond %{HTTP_USER_AGENT} (Devin|Cursor|Trae|opencode|Crawl4AI|Crawlspace|FirecrawlAgent|Scrapy|ApifyBot|ApifyWebsiteContentCrawler|Diffbot|Manus-User|Mozilla-Tabstack|TwinAgent|NagetBot) [NC,OR]
# AI-adjacent indexers, monitors and resellers
RewriteCond %{HTTP_USER_AGENT} (AddSearchBot|AzureAI-SearchBot|Aranet-SearchBot|Querit|Brightbot|Bravebot|WRTNBot|ZanistaBot|AIWebIndex|aiHitBot|AgentTimes|Anomura|Awario|BuddyBot|Channel3Bot|Cloudflare-AutoRAG|Cotoyogi|CragCrawler|Datenbank|Echobot|EchoboxBot|bigsur) [NC,OR]
RewriteCond %{HTTP_USER_AGENT} "(Factset_spyderbot|FriendlyCrawler|GeistHaus|HenkBot|IbouBot|ImagesiftBot|imageSpider|ISSCyberRiskCrawler|KlaviyoAIBot|KunatoCrawler|Linguee|MyCentralAIScraperBot|netEstate|newsai|omgili|omgilibot|Panscient|Poggio|Poseidon Research|QualifiedBot|QuillBot)" [NC,OR]
# Semrush AI/LLM crawlers only — plain SemrushBot (SEO auditing) is allowed
RewriteCond %{HTTP_USER_AGENT} (SemrushBot-OCOB|SemrushBot-SWA) [NC,OR]
RewriteCond %{HTTP_USER_AGENT} "(Shap-User|ShapBot|Sidetrade|Terra ?Cotta|Thinkbot|UseAI|VelenPublicWebCrawler|WARDBot|webzio-extended|wpbot|atlassian-bot)" [NC,OR]
# Short tokens — anchored to whole words to avoid false positives (e.g. "kayak")
RewriteCond %{HTTP_USER_AGENT} \b(YaK|LCC)\b [NC]
RewriteRule .* - [F,L]

# Block requests that send no user agent at all. Every real browser and every
# legitimate crawler identifies itself; empty UA is almost always a scraper.
RewriteCond %{HTTP_USER_AGENT} ^$
RewriteRule .* - [F,L]
</IfModule>

# ----------------------------------------------------------------------
# Static site basics
# ----------------------------------------------------------------------
DirectoryIndex index.html

# Serve the site's own 404 page instead of the host's default.
ErrorDocument 404 /404.html

# No directory listings if an index file is ever missing.
<IfModule mod_autoindex.c>
Options -Indexes
</IfModule>

# Hide dotfiles (.htaccess, .env, .git) from the web.
<FilesMatch "^\.">
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order deny,allow
	Deny from all
</IfModule>
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
