---
import BaseLayout from '../layouts/BaseLayout.astro';

const suggestions = [
  { href: '/', label: 'Introduction', description: 'Start at the beginning.' },
  { href: '/resume', label: 'Resume', description: 'Experience, roles and achievements.' },
  { href: '/contact', label: 'Contact', description: 'Email and social links.' },
];
---

<BaseLayout
  title="Page not found"
  description="That page doesn't exist. Head back to the introduction, resume, or contact page."
  currentPage="none"
  noindex
>
  <section class="py-16 md:py-24 bg-surface-900" aria-labelledby="notfound-heading">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <p class="text-sm font-semibold tracking-[0.2em] uppercase text-accent-400 mb-4">
        Error 404
      </p>
      <h1
        id="notfound-heading"
        class="text-[2rem] md:text-[3rem] font-display font-black text-text-primary mb-6"
      >
        This page doesn't exist
      </h1>
      <p class="text-lg md:text-xl text-text-secondary leading-relaxed max-w-2xl mx-auto">
        The link may be out of date, or the address might have a typo. Nothing is broken on your
        end — here's where to go instead.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-surface-blue" aria-labelledby="suggestions-heading">
    <div class="max-w-6xl mx-auto px-6">
      <h2
        id="suggestions-heading"
        class="text-[1.75rem] md:text-[2.25rem] font-display font-bold text-text-primary text-center mb-8"
      >
        Try one of these
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {suggestions.map((item) => (
          <li>
            <a
              href={item.href}
              class="block h-full bg-surface-900 rounded-xl border border-surface-700 p-6 text-center transition-colors duration-200 hover:border-accent-500 focus:outline-2 focus:outline-offset-2 focus:outline-accent-500"
            >
              <span class="block text-lg font-semibold text-accent-400 mb-2">{item.label}</span>
              <span class="block text-text-secondary">{item.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
