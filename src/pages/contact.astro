---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLink from '../components/SocialLink.astro';
import { siteMeta } from '../data/meta';
import { socialLinks } from '../data/social';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Tobby Smith — software development leader based in the Las Vegas Metropolitan Area. Connect via email or social media."
  currentPage="contact"
>
  <!-- Contact Header -->
  <section class="py-10 md:py-16 bg-neutral-50" aria-labelledby="contact-heading">
    <div class="max-w-6xl mx-auto px-6">
      <h1 id="contact-heading" class="text-[2rem] md:text-[2.75rem] font-extrabold text-neutral-900 text-center mb-6">
        Contact
      </h1>
      <p class="text-lg md:text-xl text-neutral-700 leading-relaxed max-w-3xl mx-auto text-center">
        I'm always open to connecting with fellow engineers, hiring managers, and anyone interested in discussing software development leadership. Feel free to reach out.
      </p>
    </div>
  </section>

  <!-- Email Section -->
  <section class="py-10 md:py-16" aria-labelledby="email-heading">
    <div class="max-w-6xl mx-auto px-6">
      <h2 id="email-heading" class="text-[1.75rem] md:text-[2.25rem] font-bold text-neutral-900 text-center mb-8">
        Email
      </h2>
      <div class="max-w-md mx-auto bg-white rounded-xl border border-neutral-300 p-6 text-center">
        <p class="text-neutral-700 mb-3">Primary contact method</p>
        <a
          href={`mailto:${siteMeta.email}`}
          class="text-lg font-semibold text-primary-600 hover:text-primary-500 underline underline-offset-4 transition-colors duration-200 focus:outline-2 focus:outline-offset-2 focus:outline-primary-500"
        >
          {siteMeta.email}
        </a>
      </div>
    </div>
  </section>

  <!-- Social Links Section -->
  <section class="py-10 md:py-16 bg-neutral-50" aria-labelledby="social-heading">
    <div class="max-w-6xl mx-auto px-6">
      <h2 id="social-heading" class="text-[1.75rem] md:text-[2.25rem] font-bold text-neutral-900 text-center mb-8">
        Connect
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
        {socialLinks.map((link) => (
          <SocialLink
            platform={link.platform}
            url={link.url}
            icon={link.icon}
            label={link.label}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section class="py-10 md:py-16" aria-labelledby="location-heading">
    <div class="max-w-6xl mx-auto px-6">
      <h2 id="location-heading" class="text-[1.75rem] md:text-[2.25rem] font-bold text-neutral-900 text-center mb-8">
        Location
      </h2>
      <div class="max-w-md mx-auto bg-white rounded-xl border border-neutral-300 p-6 text-center">
        <div class="flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <p class="text-lg font-semibold text-neutral-900">{siteMeta.location}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
