---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import { experience, education } from '../data/experience';
import { skills } from '../data/skills';

const highlights = [
  { value: '24+', label: 'Years Experience' },
  { value: '8–16', label: 'Engineers Managed' },
  { value: '7+', label: 'Years in Leadership' },
  { value: 'E-commerce', label: 'At Scale' },
];
---

<BaseLayout
  title="Resume"
  description="Professional resume of Tobby Smith — 24+ years of experience building high-performance web applications at scale, with 7+ years in engineering management building, scaling, and mentoring front-end teams."
  currentPage="resume"
>
  <!-- Page heading with orbs -->
  <section class="relative pt-16 md:pt-24 pb-8 bg-surface-900 overflow-hidden" aria-labelledby="resume-heading">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute w-[400px] h-[400px] rounded-full bg-blue-500/15 blur-[100px] -top-[20%] -left-[10%] animate-[orbFloat1_10s_ease-in-out_infinite]"></div>
      <div class="absolute w-[300px] h-[300px] rounded-full bg-purple-500/10 blur-[80px] top-[10%] right-[5%] animate-[orbFloat2_12s_ease-in-out_infinite]"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-6 text-center">
      <h1 id="resume-heading" class="text-[2.5rem] md:text-[4rem] font-display font-extrabold text-text-primary">
        Resume
      </h1>
      <p class="mt-3 text-lg text-text-secondary max-w-xl mx-auto">
        24+ years building for the web. 7+ years leading engineering teams.
      </p>
      <a
        href="/resume.pdf"
        download
        class="inline-flex items-center gap-2 mt-6 px-6 py-2.5 bg-accent-500 text-surface-900 font-semibold rounded-lg shadow-lg shadow-accent-500/25 hover:bg-accent-400 hover:shadow-xl hover:shadow-accent-500/40 transition-all duration-200 focus:outline-2 focus:outline-offset-2 focus:outline-accent-500"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download PDF
      </a>
    </div>
  </section>

  <!-- Highlights bar -->
  <section class="py-8 md:py-10 bg-surface-800 border-y border-surface-700" aria-label="Career highlights">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        {highlights.map((item) => (
          <div class="text-center">
            <p class="text-2xl md:text-3xl font-display font-extrabold text-accent-400">
              {item.value}
            </p>
            <p class="mt-1 text-sm text-text-secondary font-medium">
              {item.label}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Career Timeline -->
  <section class="relative py-16 md:py-20 bg-surface-900 overflow-hidden" aria-labelledby="experience-heading">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=1920&q=80&auto=format"
        alt=""
        class="w-full h-full object-cover opacity-[0.08]"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-surface-900 via-surface-900/70 to-surface-900"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-6">
      <h2 id="experience-heading" class="text-[1.75rem] md:text-[2.5rem] font-display font-bold text-text-primary text-center mb-12">
        Career History
      </h2>
      <Timeline entries={experience} />
    </div>
  </section>

  <!-- Skills Section -->
  <section class="relative py-14 md:py-20 bg-surface-blue overflow-hidden" aria-labelledby="skills-heading">
    <div class="absolute inset-0 bg-gradient-to-r from-accent-500/5 via-transparent to-purple-500/5" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-6">
      <h2 id="skills-heading" class="text-[1.75rem] md:text-[2.25rem] font-display font-bold text-text-primary text-center mb-12">
        Skills
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {skills.map((category) => (
          <div class="rounded-xl border border-surface-700 bg-surface-800/60 backdrop-blur-sm p-6">
            <div class="flex items-center gap-3 mb-5">
              <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-accent-500/10 text-accent-400" aria-hidden="true">
                <Fragment set:html={category.icon} />
              </span>
              <h3 class="text-lg font-display font-bold text-text-primary">{category.title}</h3>
            </div>
            <ul class="space-y-2.5">
              {category.skills.map((skill) => (
                <li class="flex items-center gap-2 text-sm text-text-secondary">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent-500/60 shrink-0" aria-hidden="true"></span>
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What I'm Looking For -->
  <section class="py-14 md:py-20 bg-surface-indigo" aria-labelledby="looking-for-heading">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 id="looking-for-heading" class="text-[1.75rem] md:text-[2.25rem] font-display font-bold text-text-primary mb-6">
        What I'm Looking For
      </h2>
      <p class="text-lg text-text-secondary leading-relaxed max-w-2xl mx-auto mb-8">
        I'm seeking my next engineering leadership role where I can drive large-scale impact, build high-performing teams, and modernize platforms that serve millions.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {[
          'Director of Engineering',
          'Software Development Manager',
          'Remote or Hybrid',
          'E-commerce / SaaS / Platform',
          'Teams of 10–30+',
        ].map((tag) => (
          <span class="px-4 py-2 rounded-lg text-sm font-medium bg-surface-800/80 text-accent-300 border border-accent-500/20">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Education Section -->
  <section class="py-10 md:py-14 bg-surface-900" aria-labelledby="education-heading">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 id="education-heading" class="text-[1.5rem] md:text-[1.75rem] font-display font-bold text-text-secondary mb-4">
        Education
      </h2>
      <p class="text-base text-text-muted">
        {education.map((edu) => `${edu.institution} (${edu.years})`).join(' • ')}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes orbFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(60px, 40px) scale(1.1); }
    50% { transform: translate(30px, -30px) scale(0.9); }
    75% { transform: translate(-40px, 20px) scale(1.05); }
  }

  @keyframes orbFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(-50px, 35px) scale(0.9); }
    50% { transform: translate(40px, -45px) scale(1.1); }
    75% { transform: translate(-20px, -20px) scale(0.95); }
  }

  @media (prefers-reduced-motion: reduce) {
    [class*="animate-"] {
      animation: none !important;
    }
  }
</style>
