---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteMeta } from '../data/meta';
import { socialLinks } from '../data/social';

interface Props {
  title: string;
  description: string;
  currentPage: 'home' | 'resume' | 'contact';
}

const { title, description, currentPage } = Astro.props;

const fullTitle = `${title} | ${siteMeta.siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, siteMeta.siteUrl).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": siteMeta.author,
  "jobTitle": siteMeta.profession,
  "url": siteMeta.siteUrl,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": siteMeta.location,
  },
  "sameAs": socialLinks.map((link) => link.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={siteMeta.author} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteMeta.siteName} />
    <meta property="og:image" content={`${siteMeta.siteUrl}/og-image.png`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteMeta.siteUrl}/og-image.png`} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <title>{fullTitle}</title>
  </head>
  <body class="bg-surface-900 text-text-primary font-sans min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent-500 focus:text-surface-900 focus:rounded focus:outline-2 focus:outline-offset-2 focus:outline-accent-500"
    >
      Skip to main content
    </a>

    <Navigation currentPage={currentPage} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
