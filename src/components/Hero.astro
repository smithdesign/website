---
interface Props {
  name: string;
  title: string;
  tagline: string;
}

const { name, title, tagline } = Astro.props;
---

<section class="relative w-full bg-gradient-to-br from-primary-900 via-primary-800 to-accent-500 py-20 md:py-28 lg:py-36">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center gap-10 md:gap-16">
    <!-- Headshot -->
    <div class="shrink-0 animate-hero-entrance">
      <img
        src="/images/headshot.jpg"
        alt="Tobby Smith"
        class="w-40 h-40 md:w-52 md:h-52 rounded-full object-cover border-4 border-white/20 shadow-2xl"
        onerror="this.onerror=null;this.src='/images/headshot-placeholder.svg';"
      />
    </div>

    <!-- Text content -->
    <div class="text-center md:text-left">
      <h1 class="text-[2.5rem] md:text-[4rem] font-extrabold text-white leading-tight tracking-tight animate-hero-entrance">
        {name}
      </h1>
      <p class="mt-3 text-xl md:text-2xl text-primary-100 font-medium animate-hero-entrance animation-delay-200">
        {title}
      </p>
      <p class="mt-4 max-w-2xl text-lg text-primary-100/80 animate-hero-entrance animation-delay-400">
        {tagline}
      </p>
      <a
        href="/resume"
        class="inline-block mt-8 px-8 py-3 bg-white text-primary-900 font-semibold rounded-lg shadow-lg hover:bg-primary-100 hover:shadow-xl transition-all duration-200 ease-in-out focus:outline-2 focus:outline-offset-2 focus:outline-white animate-hero-entrance animation-delay-600"
      >
        View My Resume
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes heroEntrance {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-hero-entrance {
    animation: heroEntrance 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 200ms;
  }

  .animation-delay-400 {
    animation-delay: 400ms;
  }

  .animation-delay-600 {
    animation-delay: 600ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-hero-entrance {
      animation: none;
      opacity: 1;
    }
  }
</style>
