---
interface Props {
  name: string;
  title: string;
  tagline: string;
  availability?: string;
}

const { name, title, tagline, availability } = Astro.props;
---

<section class="relative w-full overflow-hidden bg-surface-900 py-24 md:py-32 lg:py-40" id="hero-section">
  <!-- Glowing orbs -->
  <div class="hero-orbs absolute inset-0" aria-hidden="true">
    <div class="hero-orb hero-orb-1 absolute w-[500px] h-[500px] rounded-full blur-[120px]"></div>
    <div class="hero-orb hero-orb-2 absolute w-[400px] h-[400px] rounded-full blur-[100px]"></div>
    <div class="hero-orb hero-orb-3 absolute w-[350px] h-[350px] rounded-full blur-[100px]"></div>
  </div>

  <!-- Subtle grain texture overlay -->
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center gap-10 md:gap-16">
    <!-- Headshot -->
    <div class="shrink-0 animate-hero-entrance">
      <div class="relative">
        <div class="absolute -inset-3 rounded-full bg-gradient-to-br from-blue-500/40 via-purple-500/20 to-cyan-400/30 blur-xl" aria-hidden="true"></div>
        <img
          src="/images/headshot.jpg"
          alt="Tobby Smith"
          class="relative w-40 h-40 md:w-52 md:h-52 rounded-full object-cover border-2 border-accent-400/40 shadow-2xl shadow-accent-500/10"
          onerror="this.onerror=null;this.src='/images/headshot-placeholder.svg';"
        />
      </div>
    </div>

    <!-- Text content -->
    <div class="text-center md:text-left">
      <h1 class="text-[2.5rem] md:text-[4.5rem] font-display font-extrabold text-text-primary leading-[1.1] tracking-tight animate-hero-entrance">
        {name}
      </h1>
      <p class="mt-3 text-xl md:text-2xl text-accent-400 font-semibold animate-hero-entrance animation-delay-200">
        {title}
      </p>
      <p class="mt-4 max-w-2xl text-lg text-text-secondary animate-hero-entrance animation-delay-400">
        {tagline}
      </p>
      <div class="mt-8 flex flex-col items-center md:items-start gap-4 animate-hero-entrance animation-delay-600">
        {availability && (
          <p class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-500/10 border border-accent-500/25 text-sm text-accent-300 font-medium backdrop-blur-sm">
            <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse" aria-hidden="true"></span>
            {availability}
          </p>
        )}
        <a
          href="/resume"
          class="inline-block px-8 py-3 bg-accent-500 text-surface-900 font-semibold rounded-lg shadow-lg shadow-accent-500/25 hover:bg-accent-400 hover:shadow-xl hover:shadow-accent-500/40 transition-all duration-200 ease-in-out focus:outline-2 focus:outline-offset-2 focus:outline-accent-500"
        >
          View My Resume
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-orb-1 {
    top: -20%;
    left: -10%;
    background: rgba(59, 130, 246, 0.25);
    animation: orbFloat1 8s ease-in-out infinite, orbColor1 10s ease-in-out infinite;
  }

  .hero-orb-2 {
    top: 10%;
    right: -5%;
    background: rgba(168, 85, 247, 0.2);
    animation: orbFloat2 10s ease-in-out infinite, orbColor2 12s ease-in-out infinite;
  }

  .hero-orb-3 {
    bottom: -15%;
    left: 30%;
    background: rgba(34, 211, 238, 0.2);
    animation: orbFloat3 9s ease-in-out infinite, orbColor3 14s ease-in-out infinite;
  }

  @keyframes orbFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(60px, 40px) scale(1.1); }
    50% { transform: translate(30px, -30px) scale(0.9); }
    75% { transform: translate(-40px, 20px) scale(1.05); }
  }

  @keyframes orbFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(-50px, 35px) scale(0.9); }
    50% { transform: translate(40px, -45px) scale(1.1); }
    75% { transform: translate(-20px, -20px) scale(0.95); }
  }

  @keyframes orbFloat3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(45px, -35px) scale(1.12); }
    50% { transform: translate(-50px, 25px) scale(0.88); }
    75% { transform: translate(30px, 40px) scale(1.05); }
  }

  @keyframes orbColor1 {
    0%, 100% { background: rgba(59, 130, 246, 0.25); }
    33% { background: rgba(168, 85, 247, 0.25); }
    66% { background: rgba(34, 211, 238, 0.2); }
  }

  @keyframes orbColor2 {
    0%, 100% { background: rgba(168, 85, 247, 0.2); }
    33% { background: rgba(34, 211, 238, 0.2); }
    66% { background: rgba(59, 130, 246, 0.25); }
  }

  @keyframes orbColor3 {
    0%, 100% { background: rgba(34, 211, 238, 0.2); }
    33% { background: rgba(59, 130, 246, 0.2); }
    66% { background: rgba(168, 85, 247, 0.2); }
  }

  @keyframes heroEntrance {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-hero-entrance {
    animation: heroEntrance 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 200ms;
  }

  .animation-delay-400 {
    animation-delay: 400ms;
  }

  .animation-delay-600 {
    animation-delay: 600ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-hero-entrance {
      animation: none;
      opacity: 1;
    }

    .hero-orb {
      animation: none !important;
    }
  }
</style>

<script>
  function initOrbParallax() {
    const section = document.getElementById('hero-section');
    if (!section) return;

    const orbs = section.querySelectorAll<HTMLElement>('.hero-orb');
    if (!orbs.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const speeds = [0.03, -0.02, 0.015];

    let mouseX = 0;
    let mouseY = 0;
    let currentX = 0;
    let currentY = 0;
    let animating = false;

    section.addEventListener('mousemove', (e) => {
      const rect = section.getBoundingClientRect();
      mouseX = (e.clientX - rect.left - rect.width / 2);
      mouseY = (e.clientY - rect.top - rect.height / 2);

      if (!animating) {
        animating = true;
        requestAnimationFrame(updateOrbs);
      }
    });

    section.addEventListener('mouseleave', () => {
      mouseX = 0;
      mouseY = 0;
      if (!animating) {
        animating = true;
        requestAnimationFrame(updateOrbs);
      }
    });

    function updateOrbs() {
      currentX += (mouseX - currentX) * 0.08;
      currentY += (mouseY - currentY) * 0.08;

      orbs.forEach((orb, i) => {
        const speed = speeds[i] || 0.02;
        const x = currentX * speed;
        const y = currentY * speed;
        orb.style.setProperty('--mouse-x', `${x}px`);
        orb.style.setProperty('--mouse-y', `${y}px`);
        orb.style.translate = `${x}px ${y}px`;
      });

      if (Math.abs(mouseX - currentX) > 0.5 || Math.abs(mouseY - currentY) > 0.5) {
        requestAnimationFrame(updateOrbs);
      } else {
        animating = false;
      }
    }
  }

  initOrbParallax();
  document.addEventListener('astro:after-swap', initOrbParallax);
</script>
