---
import type { ExperienceEntry } from "../data/experience";

interface Props {
  entry: ExperienceEntry;
  index: number;
}

const { entry, index } = Astro.props;
const isEven = index % 2 === 0;
---

<div
  class:list={[
    "timeline-entry relative flex w-full",
    "md:w-1/2",
    isEven ? "md:self-start md:pr-10" : "md:self-end md:pl-10",
    "pl-10 md:pl-0",
  ]}
>
  {/* Timeline dot */}
  <div
    class:list={[
      "timeline-dot absolute top-6 z-10 h-4 w-4 rounded-full border-2",
      entry.isCurrent
        ? "border-accent-500 bg-accent-500 shadow-[0_0_0_4px_rgba(59,130,246,0.25),0_0_12px_rgba(59,130,246,0.4)]"
        : "border-accent-500/50 bg-surface-800",
      "left-[-8px]",
      isEven ? "md:left-auto md:right-[-8px]" : "md:left-[-8px]",
    ]}
    aria-hidden="true"
  />

  {/* Card */}
  <div
    class:list={[
      "timeline-card w-full rounded-xl border bg-surface-800 shadow-sm transition-all duration-200 hover:shadow-md hover:border-accent-500/30",
      entry.isCurrent
        ? "border-accent-500/40 p-6 md:p-8 shadow-accent-500/5"
        : "border-surface-700 p-5",
    ]}
  >
    {/* Current badge */}
    {entry.isCurrent && (
      <span class="mb-3 inline-block rounded-full bg-accent-500/15 px-3 py-1 text-xs font-semibold text-accent-400 border border-accent-500/20">
        Current Role
      </span>
    )}

    {/* Company logo + role */}
    <div class="flex items-start gap-4">
      {entry.logo && (
        <img
          src={entry.logo}
          alt={`${entry.company} logo`}
          class:list={[
            "rounded-lg object-contain bg-white/10 shrink-0 mt-0.5",
            entry.isCurrent ? "w-12 h-12 p-1" : "w-10 h-10 p-0.5",
          ]}
          loading="lazy"
        />
      )}
      <div class="flex-1 min-w-0">
        <h3 class:list={[
          "font-semibold text-text-primary leading-snug",
          entry.isCurrent ? "text-lg md:text-xl" : "text-base md:text-lg",
        ]}>
          {entry.role}
        </h3>
        <p class:list={[
          "mt-0.5 font-medium",
          entry.isCurrent ? "text-accent-400 text-base" : "text-accent-400/70 text-sm",
        ]}>
          {entry.company}
        </p>
      </div>
    </div>

    <div class:list={[
      "mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-text-muted",
      entry.isCurrent ? "text-sm" : "text-xs",
    ]}>
      <span>{entry.startDate} – {entry.endDate}</span>
      <span aria-hidden="true" class="hidden sm:inline">•</span>
      <span>{entry.location}</span>
    </div>

    <p class:list={[
      "mt-3 leading-relaxed text-text-secondary",
      entry.isCurrent ? "text-base" : "text-sm",
    ]}>
      {entry.description}
    </p>
  </div>
</div>

<style>
  @keyframes timelineDotPulse {
    0% {
      transform: scale(0.6);
      opacity: 0;
    }
    60% {
      transform: scale(1.2);
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  :global(.scroll-reveal.revealed) .timeline-dot {
    animation: timelineDotPulse 300ms ease-out forwards;
  }

  :global(.scroll-reveal.not-revealed) .timeline-dot {
    opacity: 0;
    transform: scale(0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.scroll-reveal.revealed) .timeline-dot {
      animation: none;
      opacity: 1;
      transform: scale(1);
    }

    :global(.scroll-reveal.not-revealed) .timeline-dot {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
