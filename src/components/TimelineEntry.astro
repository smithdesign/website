---
import type { ExperienceEntry } from "../data/experience";

interface Props {
  entry: ExperienceEntry;
  index: number;
}

const { entry, index } = Astro.props;
const isEven = index % 2 === 0;
---

<div
  class:list={[
    "timeline-entry relative flex w-full",
    "md:w-1/2",
    isEven ? "md:self-start md:pr-10" : "md:self-end md:pl-10",
    "pl-10 md:pl-0",
  ]}
>
  {/* Timeline dot */}
  <div
    class:list={[
      "timeline-dot absolute top-6 z-10 h-4 w-4 rounded-full border-2",
      entry.isCurrent
        ? "border-success-light bg-success-light shadow-[0_0_0_4px_rgba(16,185,129,0.2)]"
        : "border-primary-500 bg-white",
      "left-[-8px]",
      isEven ? "md:left-auto md:right-[-8px]" : "md:left-[-8px]",
    ]}
    aria-hidden="true"
  />

  {/* Card */}
  <div
    class:list={[
      "timeline-card w-full rounded-xl border bg-white p-5 shadow-sm transition-all duration-200 hover:shadow-md",
      entry.isCurrent
        ? "border-success-light/30 shadow-success-light/5"
        : "border-neutral-300",
    ]}
  >
    {/* Current badge */}
    {entry.isCurrent && (
      <span class="mb-2 inline-block rounded-full bg-success-light/10 px-3 py-1 text-xs font-semibold text-success">
        Current
      </span>
    )}

    {/* Company logo + role */}
    <div class="flex items-start gap-3">
      {entry.logo && (
        <img
          src={entry.logo}
          alt={`${entry.company} logo`}
          class="w-8 h-8 rounded object-contain bg-neutral-100 p-0.5 shrink-0 mt-0.5"
          loading="lazy"
        />
      )}
      <div class="flex-1 min-w-0">
        <h3 class="text-base font-semibold text-neutral-900 md:text-lg leading-snug">
          {entry.role}
        </h3>
        <p class:list={[
          "mt-0.5 text-sm font-medium",
          entry.isCurrent ? "text-success" : "text-primary-600",
        ]}>
          {entry.company}
        </p>
      </div>
    </div>

    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-500">
      <span>{entry.startDate} – {entry.endDate}</span>
      <span aria-hidden="true" class="hidden sm:inline">•</span>
      <span>{entry.location}</span>
    </div>

    <p class="mt-2 text-sm leading-relaxed text-neutral-700">
      {entry.description}
    </p>
  </div>
</div>

<style>
  @keyframes timelineDotPulse {
    0% {
      transform: scale(0.6);
      opacity: 0;
    }
    60% {
      transform: scale(1.2);
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  :global(.scroll-reveal.revealed) .timeline-dot {
    animation: timelineDotPulse 300ms ease-out forwards;
  }

  :global(.scroll-reveal.not-revealed) .timeline-dot {
    opacity: 0;
    transform: scale(0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.scroll-reveal.revealed) .timeline-dot {
      animation: none;
      opacity: 1;
      transform: scale(1);
    }

    :global(.scroll-reveal.not-revealed) .timeline-dot {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
