---
import type { SkillCategory } from '../data/skills';

interface Props {
  categories: SkillCategory[];
}

const { categories } = Astro.props;
---

<section class="py-8 md:py-12" aria-labelledby="skills-heading">
  <div class="max-w-6xl mx-auto px-6">
    <h2 id="skills-heading" class="text-[1.75rem] md:text-[2.25rem] font-bold text-neutral-900 text-center mb-10">
      Skills
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {categories.map((category) => (
        <div
          class:list={[
            'rounded-xl p-6 border',
            category.type === 'leadership'
              ? 'bg-accent-500/5 border-accent-500/20'
              : 'bg-primary-500/5 border-primary-500/20',
          ]}
        >
          <div class="flex items-center gap-3 mb-4">
            <span
              class:list={[
                'inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm',
                category.type === 'leadership'
                  ? 'bg-accent-500/10 text-accent-600'
                  : 'bg-primary-500/10 text-primary-600',
              ]}
              aria-hidden="true"
            >
              {category.type === 'leadership' ? '👥' : '⚙️'}
            </span>
            <h3
              class:list={[
                'text-lg font-semibold',
                category.type === 'leadership'
                  ? 'text-accent-600'
                  : 'text-primary-600',
              ]}
            >
              {category.title}
            </h3>
          </div>
          <ul class="flex flex-wrap gap-2" role="list">
            {category.skills.map((skill) => (
              <li
                class:list={[
                  'px-3 py-1.5 rounded-full text-sm font-medium',
                  category.type === 'leadership'
                    ? 'bg-accent-500/10 text-accent-600'
                    : 'bg-primary-500/10 text-primary-600',
                ]}
              >
                {skill}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
