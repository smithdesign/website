---
import type { ExperienceEntry } from "../data/experience";
import TimelineEntry from "./TimelineEntry.astro";
import ScrollReveal from "./ScrollReveal.astro";

interface Props {
  entries: ExperienceEntry[];
}

const { entries } = Astro.props;
---

<div class="timeline relative mx-auto w-full max-w-4xl">
  {/* Vertical timeline line - left on mobile, center on desktop */}
  <div
    class="timeline-line absolute left-0 top-0 h-full w-0.5 md:left-1/2 md:-translate-x-1/2"
    aria-hidden="true"
  />

  {/* Timeline entries */}
  <div class="flex flex-col gap-6 md:gap-8">
    {entries.map((entry, index) => (
      <ScrollReveal animation="fade-up" delay={index * 100}>
        <div
          class:list={[
            "relative flex",
            index % 2 === 0 ? "md:justify-start" : "md:justify-end",
          ]}
        >
          <TimelineEntry entry={entry} index={index} />
        </div>
      </ScrollReveal>
    ))}
  </div>
</div>

<style>
  .timeline-line {
    background: linear-gradient(
      to bottom,
      var(--color-accent-500),
      var(--color-accent-500) 15%,
      var(--color-surface-600) 40%,
      var(--color-surface-700)
    );
    box-shadow: 0 0 8px var(--color-accent-500), 0 0 20px rgba(59, 130, 246, 0.15);
  }
</style>
