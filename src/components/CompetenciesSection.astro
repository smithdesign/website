---
import CompetencyCard from './CompetencyCard.astro';
import ScrollReveal from './ScrollReveal.astro';

const competencies = [
  {
    title: 'Engineering Team Leadership',
    description: 'Building, scaling, and mentoring high-performing front-end engineering teams.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    title: 'Platform Architecture & Modernization',
    description: 'Leading large-scale migrations and modernizing legacy systems for performance and maintainability.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
  },
  {
    title: 'Stakeholder & Roadmap Management',
    description: 'Aligning technical strategy with business goals through cross-functional collaboration.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>`,
  },
  {
    title: 'Performance Optimization at Scale',
    description: 'Driving Core Web Vitals improvements and delivering fast experiences to millions of users.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  },
];
---

<section class="py-10 md:py-16" aria-labelledby="competencies-heading">
  <div class="max-w-6xl mx-auto px-6">
    <h2 id="competencies-heading" class="text-[1.75rem] md:text-[2.25rem] font-bold text-neutral-900 text-center mb-10">
      Core Competencies
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {competencies.map((competency, index) => (
        <ScrollReveal animation="fade-up" delay={index * 100}>
          <CompetencyCard
            title={competency.title}
            description={competency.description}
            icon={competency.icon}
          />
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>
