---
interface Props {
  title: string;
  description?: string;
  icon?: string;
}

const { title, description, icon } = Astro.props;
---

<div class="competency-card group rounded-xl border border-neutral-300 bg-white p-6 shadow-sm transition-all duration-200 ease-in-out hover:shadow-md hover:border-primary-500/40 hover:-translate-y-0.5">
  {icon && (
    <span class="mb-3 block text-primary-600" aria-hidden="true" set:html={icon} />
  )}
  <h3 class="text-lg font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-200">
    {title}
  </h3>
  {description && (
    <p class="mt-2 text-sm text-neutral-700 leading-relaxed">
      {description}
    </p>
  )}
</div>

<style>
  .competency-card:focus-within {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }
</style>
