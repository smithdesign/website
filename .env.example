# Template only — no real secrets in this file. It IS committed to git.
# Copy to .env and fill in your webhost's FTP details. .env is gitignored.
#
# With FTP_SECURE=true this must match the server's TLS certificate. Shared
# hosts often serve a wildcard cert for their own domain, so ftp.<your-domain>
# fails verification even with correct credentials — use the hostname from
# `host <your-domain>` (e.g. ns811.websitewelcome.com) instead.
FTP_HOST=ftp.example.com
FTP_USER=your-ftp-username
FTP_PASSWORD=your-ftp-password

# 21 for FTP/FTPS-explicit, 990 for FTPS-implicit.
FTP_PORT=21

# Set to true if your host supports FTPS. Plain FTP sends the password in clear text.
FTP_SECURE=true

# Where the site lives on the host. Commonly /public_html, /htdocs, or /www.
FTP_REMOTE_DIR=/public_html

# Set to true to log the raw FTP conversation when debugging.
FTP_VERBOSE=false
